{
  "name": "collabai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host=0.0.0.0 --port=4200",
    "start": "ng serve --host=0.0.0.0 --port=4200",
    "build": "node ./scripts/set-env.js && ng build",
    "build:render": "node ./scripts/set-env.js && ng build",
    "lint": "eslint \"src/**/*.{ts,html}\" \"tests/**/*.ts\"",
    "test": "tsx tests/realtime-state.test.ts",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20.19 <25",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@angular/animations": "21.2.14",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.14",
    "@angular/compiler": "21.2.14",
    "@angular/core": "21.2.14",
    "@angular/forms": "21.2.14",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.14",
    "@angular/router": "21.2.14",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.14",
    "@angular/cli": "21.2.14",
    "@angular/compiler-cli": "21.2.14",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
